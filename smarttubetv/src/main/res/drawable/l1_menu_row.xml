<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/l1_menu_focus_surface"/>
            <stroke android:width="2dp" android:color="@color/l1_focus"/>
            <corners android:radius="@dimen/l1_menu_row_radius"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/l1_menu_focus_surface"/>
            <stroke android:width="2dp" android:color="@color/l1_focus"/>
            <corners android:radius="@dimen/l1_menu_row_radius"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/l1_menu_row_surface"/>
            <corners android:radius="@dimen/l1_menu_row_radius"/>
        </shape>
    </item>
</selector>
